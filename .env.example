# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------- database
# Supabase > Project Settings > Database > Connection string
# DATABASE_URL uses the pooler (port 6543) and is what the app runs on.
# DATABASE_URL_DIRECT uses the direct connection (port 5432) and is what
# migrations run on — the pooler cannot run DDL reliably.
DATABASE_URL=
DATABASE_URL_DIRECT=

# ---------------------------------------------------------------- supabase
# Used for realtime and file storage. Auth is handled by Clerk, not Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------- clerk
# Clerk > API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk > Webhooks — keeps the users table in sync.
# Name matters: verifyWebhook() reads CLERK_WEBHOOK_SIGNING_SECRET by default.
CLERK_WEBHOOK_SIGNING_SECRET=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# ------------------------------------------------------------------- email
# Resend — invite codes and the daily digest
RESEND_API_KEY=
EMAIL_FROM="Revert <hello@revert.example>"

# -------------------------------------------------------- push (FCM / web)
# Firebase > Project Settings > Cloud Messaging
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Server-only, for sending pushes
FIREBASE_SERVICE_ACCOUNT_JSON=

# ----------------------------------------------------------------- inngest
# Scheduled jobs: the daily digest, expiring job posts, unbans
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --------------------------------------------------------------- analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ------------------------------------------------------------------ errors
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --------------------------------------------------------------------- app
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated Clerk user ids that get admin access before the DB flag exists
ADMIN_CLERK_IDS=

# Set to "true" to require an invite code at signup. Off means open signup.
REQUIRE_INVITE_CODE=false
